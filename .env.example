NODE_ENV=development
PORT=3000
# Routes resolve to /{API_PREFIX}/v{version}/... ; controllers declare their
# own version, so a v2 can ship beside v1 without changing these.
API_PREFIX=api
API_DEFAULT_VERSION=1

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=blog
DB_PASSWORD=change-me
DB_NAME=blog_post_api
# Leave false and use migrations. Ignored entirely when NODE_ENV=production.
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Three distinct secrets, 32+ chars each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_SECRET=
JWT_RESET_EXPIRES_IN=10m

# App-wide default budget; auth routes set their own tighter limits.
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Comma-separated allowlist. Empty means same-origin only — never use "*".
CORS_ORIGINS=http://localhost:3000
